generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model autor {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String        @db.VarChar(100)
  nascionalidade  String        @db.VarChar(50)
  data_nascimento DateTime? @db.Date
  ativo           Boolean       @default(true)
  livro_autor     livro_autor[]
}

model categoria {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String  @unique @db.VarChar(100)
  descricao String?
  ativo     Boolean @default(true)
  livro     livro[]
}

model devolucao {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exemplar_id    String    @db.Uuid
  data_devolucao DateTime? @default(now()) @db.Timestamp(6)
  funcionario_id String    @db.Uuid
  situacao       String?   @db.VarChar(100)
  exemplar       exemplar  @relation(fields: [exemplar_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exemplar_devolucao")
  usuario        usuario   @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_funcionario_devolucao")
}

model emprestimo {
  id                                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id                                 String                @db.Uuid
  funcionario_id                             String                @db.Uuid
  data_emprestimo                            DateTime?             @default(now()) @db.Timestamp(6)
  estado_conservacao                         String                @db.VarChar(25)
  status                                     String?               @default("Em aberto") @db.VarChar(25)
  data_devolucao_prev                        DateTime @db.Date
  data_devolucao                             DateTime?             @db.Timestamp(6)
  usuario_emprestimo_funcionario_idTousuario usuario               @relation("emprestimo_funcionario_idTousuario", fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_funcionario_emprestimo")
  usuario_emprestimo_usuario_idTousuario     usuario               @relation("emprestimo_usuario_idTousuario", fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_emprestimo")
  emprestimo_exemplar                        emprestimo_exemplar[]
}

model emprestimo_exemplar {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emprestimo_id String     @db.Uuid
  exemplar_id   String     @db.Uuid
  emprestimo    emprestimo @relation(fields: [emprestimo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emprestimo_exemplar")
  exemplar      exemplar   @relation(fields: [exemplar_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exemplar_emprestimo")
}

model exemplar {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cod_identificacao   Int                   @unique(map: "unq_cod_identificacao")
  livro_id            String                @db.Uuid
  data_aquisicao      DateTime? @db.Date
  estado_conservacao  String?               @db.VarChar(50)
  status              String?               @default("Disponivel") @db.VarChar(50)
  ativo               Boolean               @default(true)
  devolucao           devolucao[]
  emprestimo_exemplar emprestimo_exemplar[]
  livro               livro                 @relation(fields: [livro_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_livro_exemplar")
}

model livro {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isbn           Int           @unique
  titulo         String        @db.VarChar(100)
  ano_publicacao Int
  edicao         String?       @db.VarChar(100)
  editora        String?       @db.VarChar(100)
  categoria_id   String        @db.Uuid
  descricao      String?
  ativo          Boolean       @default(true)
  exemplar       exemplar[]
  categoria      categoria     @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoria_livro")
  livro_autor    livro_autor[]
}

model livro_autor {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  livro_id String  @db.Uuid
  autor_id String  @db.Uuid
  ativo    Boolean @default(true)
  autor    autor   @relation(fields: [autor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_autor_livro")
  livro    livro   @relation(fields: [livro_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_livro_autor")
}

model usuario {
  id                                            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                                          String       @db.VarChar(100)
  cpf                                           String       @unique @db.VarChar(15)
  email                                         String       @unique @db.VarChar(100)
  senha                                         String
  telefone                                      String       @db.VarChar(25)
  data_nascimento                               DateTime? @db.Date
  endereco                                      String?      @db.VarChar(100)
  data_cadastro                                 DateTime?    @default(now()) @db.Timestamp(6)
  status                                        String?      @default("ativo") @db.VarChar(50)
  perfil                                        String?      @default("atendente") @db.VarChar(50)
  devolucao                                     devolucao[]
  emprestimo_emprestimo_funcionario_idTousuario emprestimo[] @relation("emprestimo_funcionario_idTousuario")
  emprestimo_emprestimo_usuario_idTousuario     emprestimo[] @relation("emprestimo_usuario_idTousuario")
}
